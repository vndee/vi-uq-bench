# Data and run outputs are never committed. The dataset is shared on request
# (see data/README.md); everything else is regenerated by the pipeline.
data/*
!data/README.md
!data/.gitkeep
artifacts/*
!artifacts/README.md
!artifacts/.gitkeep
results/*
!results/.gitkeep

# belt and braces: data-like files anywhere
*.csv
*.tsv
!configs/models.tsv
*.jsonl
*.npz
*.npy
*.xlsx
*.pkl
*.parquet
*.pdf

# keys
*.key
*key*.txt
.env

__pycache__/
*.pyc
.venv/
